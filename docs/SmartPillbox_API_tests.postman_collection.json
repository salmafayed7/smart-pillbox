              "mode": "raw",
              "raw": "{\n  \"patient_id\": {{patient_id}},\n  \"prescription_medicine_id\": {{med_id}},\n  \"slot_number\": 1,\n  \"pill_count\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created\", function () { pm.expect(pm.response.code).to.equal(201); pm.collectionVariables.set('comp_id', pm.response.json()[0].id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Add a dose time",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{manager_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": "{{base_url}}/rest/v1/schedules",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": {{patient_id}},\n  \"compartment_id\": {{comp_id}},\n  \"start_date\": \"{{today}}\",\n  \"end_date\": \"{{end}}\",\n  \"med_time\": \"08:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const iso = d => d.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('today', iso(new Date()));",
                  "pm.collectionVariables.set('end', iso(new Date(Date.now() + 7 * 864e5)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created\", function () { pm.expect(pm.response.code).to.equal(201); pm.collectionVariables.set('sched_id', pm.response.json()[0].id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cannot attach to a different patient id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{manager_token}}"
              },
              {
