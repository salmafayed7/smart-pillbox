              }
            ],
            "url": "{{base_url}}/rest/v1/change_log?select=actor_name,actor_role,table_name,action&order=created_at.desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"caregiver's changes are logged by name\", function () { const rows = pm.response.json(); pm.expect(rows.some(r => r.actor_name === 'Care Manager' && r.table_name === 'prescription_medicines')).to.equal(true); pm.expect(rows.some(r => r.actor_name === 'Care Manager' && r.table_name === 'schedules')).to.equal(true); });"
                ]
              }
            }
          ]
        }
      ]
