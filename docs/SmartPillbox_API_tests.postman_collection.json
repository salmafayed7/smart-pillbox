          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Paracetamol is visible to the patient\", function () { pm.expect(pm.response.json().map(r => r.med_name)).to.include('Paracetamol'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Patient sees the activity log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
